# Local editor/tooling metadata — not part of the site.
.freebuff/

# The build has no dependencies and installs none, but `npm install` creates this.
node_modules/

# Staging directory the Pages deploy workflow assembles and uploads.
_site/

# Fonts fetched and digest-checked by scripts/social-preview.py. Not part of the site.
.cache/

# Bytecode from the tools that import each other (scripts/photos.py, not part of the site).
__pycache__/

# The mail snapshot this machine took before a nameserver move. Local evidence for one cutover,
# not something a later run should inherit from the repository.
mail-baseline.json

# Logs.
*.log
npm-debug.log*

# OS/editor noise.
.DS_Store
Thumbs.db
desktop.ini
